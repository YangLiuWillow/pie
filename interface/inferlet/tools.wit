interface tools {
    use grammar.{grammar, matcher};
    use types.{error};

    /// A complete tool call parsed out of the model's output.
    record tool-call {
        name: string,
        arguments-json: string,
    }

    variant event {
        /// Tool call detected
        start,
        /// Complete tool call
        call(tool-call),
    }

    /// Register available tools (list of JSON schema strings)
    equip: func(tools: list<string>) -> result<list<u32>, error>;

    /// Register available tools, merging `system-content` (a caller-supplied
    /// leading system message, if any) into the same system turn as the
    /// tool schemas — matching chat templates (e.g. Qwen's) that fold both
    /// into one turn rather than two separate consecutive system turns.
    /// Falls back to a plain system-turn + `equip` concatenation for models
    /// without a specific merge rule.
    equip-after-system: func(system-content: option<string>, tools: list<string>) -> result<list<u32>, error>;

    /// Provide a tool result (after a tool-call reply)
    answer: func(name: string, value: string) -> list<u32>;

    /// Replay a past assistant turn that made one or more tool calls.
    /// `content` is any free text that preceded the call(s); `calls` are
    /// in order, with `arguments-json` already JSON-encoded. For models
    /// without tool support, falls back to a plain assistant-text replay
    /// of `content`.
    assistant-with-tool-calls: func(content: option<string>, calls: list<tool-call>) -> list<u32>;

    /// Replay one or more past tool results as a single merged turn — most
    /// chat templates group consecutive tool results into one turn rather
    /// than one per result. `results` are (name, value) pairs, in order.
    answer-batch: func(results: list<tuple<string, string>>) -> list<u32>;

    /// Returns the grammar that constrains well-formed tool-call output for
    /// this model and toolset, or none if the model has no enforceable format.
    format: func(tools: list<string>) -> option<grammar>;

    /// Create a grammar matcher to force-generate tool calls
    create-matcher: func(tools: list<string>) -> matcher;

    /// Detects tool calls in generated tokens.
    resource decoder {
        constructor();
        /// The same decoder, told which tools this request offered.
        ///
        /// Additive rather than a change to `constructor`, which every existing
        /// guest calls. Only one dialect needs it: Qwen3-Coder spells a call as
        /// XML, and XML carries no types, so the schema is the only thing that
        /// can say whether `30` is the number 30 or the string "30". A decoder
        /// built by the bare constructor still reports every call — it types
        /// each argument as a string.
        with-tools: static func(tools: list<string>) -> decoder;
        feed: func(tokens: list<u32>) -> result<event, error>;
        reset: func();
    }
}
