interface chat {
    use types.{error};
    use tools.{tool-call};

    variant event {
        /// Generated text chunk
        delta(string),
        /// Special token encountered (token ID)
        interrupt(u32),
        /// Generation complete (full accumulated text)
        done(string),
    }

    /// Fill roles for history replay
    system: func(message: string) -> list<u32>;
    first-user: func(message: string) -> list<u32>;
    user: func(message: string) -> list<u32>;
    system-user: func(system: string, user: string) -> list<u32>;
    /// Replay a past assistant turn.
    ///
    /// `after-query` and `is-last` place the turn, which is what decides
    /// whether the template opens it with a reasoning block. Neither is
    /// knowable from the turn itself -- only the holder of the message list
    /// knows where the last real user query was, or which turn is final:
    ///
    ///   Qwen3    a block if after the query AND (last OR it carries reasoning)
    ///   Qwen3.6  a block if after the query
    ///
    /// A family whose template has no reasoning channel ignores both.
    assistant: func(message: string, after-query: bool, is-last: bool) -> list<u32>;

    /// [`assistant`] for a turn that also made tool calls.
    ///
    /// `content` is any free text that preceded the call(s); `calls` are in
    /// order, with `arguments-json` already JSON-encoded. A model without tool
    /// support falls back to a plain assistant-text replay of `content`.
    assistant-call: func(content: option<string>, calls: list<tool-call>,
                         after-query: bool, is-last: bool) -> list<u32>;

    /// Cue the model to generate (fills generation header).
    ///
    /// `thinking` is the template's `enable_thinking`. It is a PARAMETER and
    /// not a second function on purpose: this was `cue` plus `cue-no-think`,
    /// which reified one template branch as API surface and then did not
    /// generalise -- when the same distinction was needed for a REPLAYED
    /// assistant turn there was nothing to reach for, and the turn silently
    /// lost its reasoning block. vLLM, mlx-lm and llama.cpp all pass
    /// `enable_thinking` as data into one render path; so does this now.
    ///
    /// For a model with no thinking channel both values render the same
    /// bytes.
    cue: func(thinking: bool) -> list<u32>;

    /// Seal the current turn (insert stop token)
    seal: func() -> list<u32>;

    /// Returns the stop token IDs for the model
    stop-tokens: func() -> list<u32>;

    /// Classifies generated tokens.
    resource decoder {
        constructor();
        feed: func(tokens: list<u32>) -> result<event, error>;
        reset: func();
    }
}
