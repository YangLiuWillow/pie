interface tool-use {
    use pie:core/model.{model};
    use pie:core/inference.{grammar, matcher};
    use pie:core/types.{error};

    variant event {
        /// Tool call detected
        start,
        /// Complete tool call: (name, arguments-json)
        call(tuple<string, string>),
    }

    /// Register available tools (list of JSON schema strings)
    equip: func(model: borrow<model>, tools: list<string>) -> result<list<u32>, error>;

    /// Register available tools, merging `system-content` (a caller-supplied
    /// leading system message, if any) into the same system turn as the
    /// tool schemas — matching chat templates (e.g. Qwen's) that fold both
    /// into one turn rather than two separate consecutive system turns.
    /// Falls back to a plain system-turn + `equip` concatenation for models
    /// without a specific merge rule.
    equip-after-system: func(model: borrow<model>, system-content: option<string>, tools: list<string>) -> result<list<u32>, error>;

    /// Provide a tool result (after a tool-call reply)
    answer: func(model: borrow<model>, name: string, value: string) -> list<u32>;

    /// Replay a past assistant turn that made one or more tool calls.
    /// `content` is any free text that preceded the call(s); `calls` are
    /// (name, arguments-json) pairs, in order. For models without tool
    /// support, falls back to a plain assistant-text replay of `content`.
    assistant-with-tool-calls: func(model: borrow<model>, content: option<string>, calls: list<tuple<string, string>>) -> list<u32>;

    /// Replay one or more past tool results as a single merged turn — most
    /// chat templates group consecutive tool results into one turn rather
    /// than one per result. `results` are (name, value) pairs, in order.
    answer-batch: func(model: borrow<model>, results: list<tuple<string, string>>) -> list<u32>;

    /// Create a decoder to detect tool calls in generated tokens
    create-decoder: func(model: borrow<model>) -> decoder;

    /// Returns the grammar that constrains well-formed tool-call output for
    /// this model and toolset, or none if the model has no enforceable format.
    format: func(model: borrow<model>, tools: list<string>) -> option<grammar>;

    /// Create a grammar matcher to force-generate tool calls
    create-matcher: func(model: borrow<model>, tools: list<string>) -> matcher;

    resource decoder {
        feed: func(tokens: list<u32>) -> result<event, error>;
        reset: func();
    }
}
